          "type": "number"
        },
        "risk": {
          "default": 0.0,
          "title": "Risk",
          "type": "number"
        },
        "route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
