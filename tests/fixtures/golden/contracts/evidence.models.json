            }
          ],
          "default": null,
          "title": "File"
        },
        "fingerprint": {
          "default": "",
          "title": "Fingerprint",
          "type": "string"
        },
        "fix_diff": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
