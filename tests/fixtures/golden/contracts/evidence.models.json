{
  "AgentDecision": {
    "kind": "model",
    "schema": {
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "finding_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "input_summary_json": {
          "default": "{}",
          "title": "Input Summary Json",
          "type": "string"
        },
        "node": {
          "default": "",
          "title": "Node",
          "type": "string"
        },
        "output_json": {
          "default": "{}",
          "title": "Output Json",
          "type": "string"
        },
        "scan_id": {
          "title": "Scan Id",
          "type": "string"
        },
        "source": {
          "default": "rule",
          "title": "Source",
          "type": "string"
        },
        "valid": {
          "default": true,
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "scan_id"
      ],
      "title": "AgentDecision",
      "type": "object"
    }
  },
  "Claim": {
    "kind": "model",
    "schema": {
      "description": "Explanation sentence (DB table). Distinct from the agent-schema ``Claim``\npydantic model used for LLM output (conflict C27: same name, different\nmodule and purpose).",
      "properties": {
        "evidence_ids_json": {
          "default": "[]",
          "title": "Evidence Ids Json",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "kept": {
          "default": true,
          "title": "Kept",
          "type": "boolean"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "field"
      ],
      "title": "Claim",
      "type": "object"
    }
  },
  "Counter": {
    "kind": "model",
    "schema": {
      "description": "Monotonic per-prefix counter for human-readable IDs (S/F/E/X/D).",
      "properties": {
        "prefix": {
          "title": "Prefix",
          "type": "string"
        },
        "value": {
          "default": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "prefix"
      ],
      "title": "Counter",
      "type": "object"
    }
  },
